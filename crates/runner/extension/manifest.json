{
  "manifest_version": 3,
  "name": "Aperture session",
  "version": "1.0.0",
  "description": "Keeps each page in a browser window of its own and takes the sound of each tab apart from the others.",
  "key": "",
  "permissions": ["nativeMessaging", "offscreen", "storage", "tabCapture", "tabs"],
  "background": {
    "service_worker": "worker.js"
  }
}
