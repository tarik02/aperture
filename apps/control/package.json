{
  "name": "@aperture-browser/control",
  "version": "1.0.0-beta.5",
  "private": true,
  "description": "The control plane: accounts, the nodes that register with it, where sessions run, and the tickets into them.",
  "type": "module",
  "scripts": {
    "start": "node dist/main.mjs",
    "generate": "buf generate ../.. --template buf.gen.yaml --path ../../proto/aperture/control/v1/nodes.proto && cargo run --quiet --package aperture-runner --bin aperture-runner -- tools > src/mcp/gen/session-tools.json",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit",
    "build": "vp pack"
  },
  "dependencies": {
    "@aperture-browser/control-api": "workspace:*",
    "@aperture-browser/executor-client": "workspace:*",
    "@aperture-browser/shared": "workspace:*",
    "@better-auth/passkey": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "bcryptjs": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@aperture-browser/e2e": "workspace:*",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
