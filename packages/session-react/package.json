{
  "name": "@aperture-browser/session-react",
  "version": "0.0.0",
  "description": "React components for embedding a live Aperture browser session, with or without its tab strip.",
  "homepage": "https://github.com/tarik02/aperture#readme",
  "bugs": "https://github.com/tarik02/aperture/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarik02/aperture.git",
    "directory": "packages/session-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/finalize-styles.ts && publint",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p scripts"
  },
  "dependencies": {
    "@aperture-browser/api-client": "workspace:^",
    "@aperture-browser/live-session": "workspace:^",
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@aperture-browser/ui": "workspace:*",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "effect": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.117",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
