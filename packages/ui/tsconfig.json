{
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@aperture-browser/ui/components": ["./src/components"],
      "@aperture-browser/ui/components/*": ["./src/components/*"],
      "@aperture-browser/ui/hooks": ["./src"],
      "@aperture-browser/ui/hooks/*": ["./src/*"],
      "@aperture-browser/ui/lib": ["./src"],
      "@aperture-browser/ui/lib/*": ["./src/*"],
      "@aperture-browser/ui/utils": ["./src/utils.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
