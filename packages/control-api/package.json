{
  "name": "@aperture-browser/control-api",
  "version": "1.0.0-beta.2",
  "description": "The API of an Aperture control plane as its server and its callers read it: the routes, what goes over them and how they fail, with a typed client.",
  "homepage": "https://github.com/tarik02/aperture#readme",
  "bugs": "https://github.com/tarik02/aperture/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarik02/aperture.git",
    "directory": "packages/control-api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./errors": "./src/errors.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "effect": "catalog:",
    "publint": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  }
}
