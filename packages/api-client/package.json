{
  "name": "@aperture-browser/api-client",
  "version": "0.0.0",
  "description": "Effect services for the Aperture API: sessions, snapshots, tenants, users, tokens, events and authentication.",
  "homepage": "https://github.com/tarik02/aperture#readme",
  "bugs": "https://github.com/tarik02/aperture/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarik02/aperture.git",
    "directory": "packages/api-client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./passkeys": "./src/passkeys.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./passkeys": {
        "types": "./dist/passkeys.d.ts",
        "default": "./dist/passkeys.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@aperture-browser/api-schema": "workspace:*"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "catalog:",
    "effect": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@simplewebauthn/browser": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    }
  }
}
