{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "aperture",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/api-schema/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/api-client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/live-session/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/session-react/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/session-element/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
