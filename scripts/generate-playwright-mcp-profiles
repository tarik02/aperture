#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_path="${1:-${repo_root}/internal/playwrightmcp/profiles.json}"
playwright_mcp_bin="${PLAYWRIGHT_MCP_BIN:-${repo_root}/backend/restore-worker/node_modules/.bin/playwright-mcp}"

exec go run -tags tools ./cmd/generate-playwright-mcp-profiles "${playwright_mcp_bin}" "${output_path}"
