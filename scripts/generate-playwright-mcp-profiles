#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_path="${1:-${repo_root}/internal/playwrightmcp/profiles.json}"
host="${BROWSER_MCP_HOST:-${repo_root}/apps/browser-mcp/dist/main.mjs}"

# The host is built first: pnpm --filter @aperture-browser/browser-mcp build
exec go run -tags tools ./cmd/generate-playwright-mcp-profiles "${output_path}" node "${host}"
