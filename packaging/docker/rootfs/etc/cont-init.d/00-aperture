#!/command/with-contenv sh
set -eu

if [ -z "${APERTURE_EXTERNAL_BASE_URL:-}" ]; then
  echo "APERTURE_EXTERNAL_BASE_URL is required" >&2
  exit 64
fi

if [ -n "${APERTURE_CONFIG_SOURCE:-}" ]; then
  install -m 0644 -o root -g root \
    "$APERTURE_CONFIG_SOURCE" \
    /etc/aperture/aperture.toml
fi

# The mount helpers read cold_root only from the config file, not the
# environment, so a cold root chosen by environment is written into it.
cold_root="${APERTURE_COLD_ROOT:-}"
if [ -n "$cold_root" ]; then
  if grep -qxF "cold_root = \"$cold_root\"" /etc/aperture/aperture.toml; then
    :
  elif grep -q '^cold_root = ' /etc/aperture/aperture.toml; then
    sed -i "s|^cold_root = .*|cold_root = \"$cold_root\"|" /etc/aperture/aperture.toml
  else
    sed -i "1i cold_root = \"$cold_root\"" /etc/aperture/aperture.toml
  fi
  install -d -m 0750 -o aperture -g aperture "$cold_root"
fi

if [ -n "${APERTURE_DATABASE_PATH:-}" ]; then
  install -d -m 0700 -o aperture -g aperture "$(dirname "$APERTURE_DATABASE_PATH")"
fi

seen_device_gids=""
for device in /dev/dri/card* /dev/dri/renderD*; do
  [ -e "$device" ] || continue
  gid="$(stat -c %g "$device")"
  case " $seen_device_gids " in
    *" $gid "*) continue ;;
  esac
  echo "aperture-device-$gid:x:$gid:aperture" >> /etc/group
  seen_device_gids="$seen_device_gids $gid"
done

install -d -m 0750 -o aperture -g aperture \
  /home/aperture \
  /var/lib/aperture \
  /var/lib/aperture/artifacts \
  /run/aperture \
  /run/aperture/state \
  /run/aperture/traefik \
  /run/aperture/traefik/dynamic
install -d -m 0700 -o aperture -g aperture /run/aperture/user
