{
  "manifest_version": 3,
  "name": "Aperture tab window enforcer",
  "version": "1.0.0",
  "description": "Keeps each managed Aperture page in its own Chromium popup window.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}
