# Where people reach Aperture. Signing in takes requests from pages of that origin alone.
APERTURE_URL=http://localhost

# Where the proxy listens on this machine.
#APERTURE_LISTEN=:80

# The ports the control plane and the node listen on, on loopback, where the others reach
# them. Change them when something on the machine has them already.
#APERTURE_CONTROL_PORT=7800
#APERTURE_NODE_PORT=7900

# Under podman, which does not take Docker's systempaths=unconfined from compose, sessions'
# browsers do not start (`bwrap: Can't mount proc on /proc`) without this:
#APERTURE_UNMASK=unmask=ALL

# The images' tag: `beta`, or a version such as 1.0.0-beta.1.
#APERTURE_VERSION=beta

# The node's name, and the UDP ports its sessions' video and sound use. Open them to whoever
# watches a session.
#APERTURE_NODE=node
#APERTURE_RTC_PORTS=60000-60999

# Where Prometheus scrapes the control plane's and the node's metrics, on this machine, at
# /metrics. None are served without them. They answer anyone who reaches them.
#APERTURE_CONTROL_METRICS_LISTEN=127.0.0.1:9465
#APERTURE_NODE_METRICS_LISTEN=127.0.0.1:9464
# Leave out of the node's metrics what each running session uses, labelled with its id.
#APERTURE_METRICS_NO_PER_SESSION=true
